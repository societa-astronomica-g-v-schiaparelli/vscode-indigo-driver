        {
          "match": "\\b(?:INDIGO_[A-Z0-9_]+|[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*_(?:PROPERTY|ITEM)(?:_NAME)?|MAIN_GROUP|[A-Z][A-Z0-9]*_GROUP)\\b",
          "name": "support.constant.indigo.indigo-driver"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()",
