        },
        {
          "begin": "\\b(inherited|switch|text|number|light)\\s+([A-Za-z][A-Za-z0-9_]*)\\s*(\\{)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.property.indigo-driver"
            },
            "2": {
              "name": "entity.name.function.property.indigo-driver"
