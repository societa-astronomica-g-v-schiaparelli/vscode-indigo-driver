    "expression": {
      "patterns": [
        {
          "match": "\"(?:\\\\.|[^\"\\\\])*\"",
          "name": "string.quoted.double.indigo-driver"
        },
        {
          "match": "'(?:\\\\.|[^'\\\\])*'",
          "name": "string.quoted.single.indigo-driver"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.indigo-driver"
        },
        {
          "match": "\\b(?:0[xX][0-9a-fA-F]+|[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)[uUlLfF]*\\b",
          "name": "constant.numeric.indigo-driver"
